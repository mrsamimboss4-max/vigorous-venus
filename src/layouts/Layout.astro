---
import '../styles/global.css';
import Toast from '../components/Toast.astro';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "SweepGrid — Screenshot & Trash Manager for Windows & Android", 
	description = "Easily organize, preview, and sweep screenshot clutter on Windows and Android. 100% private, local storage utility with safe trash safeguards."
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Theme Initialization Script -->
		<script is:inline>
			(function() {
				const savedTheme = localStorage.getItem('sweepgrid-theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>

		<!-- Service Worker Cleanup (ensure fresh Sweepgrid delivery) -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.getRegistrations().then(function(registrations) {
					for (let registration of registrations) {
						registration.unregister();
					}
				});
			}
		</script>
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Sweepgrid, Windows screenshot organizer, Android screenshot cleaner, MediaStore trash manager, Windows Recycle Bin, Android APK download, Microsoft Store, cross-platform screenshot organizer, purge screenshots, The Black Rose, local file manager, private screenshot tool" />
		<link rel="canonical" href={`https://www.sweepgrid.com${Astro.url.pathname}`} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`https://www.sweepgrid.com${Astro.url.pathname}`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://www.sweepgrid.com/og-image.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={`https://www.sweepgrid.com${Astro.url.pathname}`} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://www.sweepgrid.com/og-image.png" />

		<!-- JSON-LD Structured Data: SoftwareApplication & Organization -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "SoftwareApplication",
						"@id": "https://www.sweepgrid.com/#software",
						"name": "SweepGrid",
						"operatingSystem": "Windows 10, Windows 11, Android 10+",
						"applicationCategory": "UtilitiesApplication",
						"description": "Cross-platform screenshot cleanup & auto-sweep utility for Windows and Android with local file processing and zero server data storage.",
						"offers": {
							"@type": "Offer",
							"price": "0",
							"priceCurrency": "USD"
						},
						"author": {
							"@type": "Organization",
							"name": "The Black Rose",
							"url": "https://www.sweepgrid.com"
						},
						"downloadUrl": "https://www.sweepgrid.com/sweepgrid.apk",
						"installUrl": "https://apps.microsoft.com/detail/9PN8GFTX73ZH"
					},
					{
						"@type": "Organization",
						"@id": "https://www.sweepgrid.com/#organization",
						"name": "The Black Rose",
						"url": "https://www.sweepgrid.com",
						"logo": "https://www.sweepgrid.com/og-image.png",
						"sameAs": [
							"https://apps.microsoft.com/detail/9PN8GFTX73ZH"
						]
					}
				]
			}
		</script>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-CYW16TF51H"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-CYW16TF51H');
		</script>
	</head>
	<body class="font-sans antialiased text-ink bg-canvas-soft font-feature-geom min-h-screen flex flex-col selection:bg-emerald-500 selection:text-white">
		<slot />

		<!-- Global Toast Container -->
		<Toast />
	</body>
</html>
