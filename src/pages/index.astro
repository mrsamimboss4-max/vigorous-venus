---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Sweepgrid — Cross-Platform Screenshot & Trash Manager for Windows & Android" 
  description="Sweepgrid is the ultimate local utility designed for Windows and Android to instantly preview, organize, and purge messy screenshot directories and media clutter in seconds. 100% private and offline."
>
  <!-- Background Mesh Gradient decoration -->
  <div class="mesh-gradient-bg"></div>

  <div class="min-h-screen flex flex-col font-sans">
    <Header currentView="home" />

    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8 md:py-12">
      
      <!-- ========================================== -->
      <!-- VIEW 1: HOME PAGE                          -->
      <!-- ========================================== -->
      <div id="page-home" class="page-view active space-y-16 md:space-y-24">
        
        <!-- HERO SECTION -->
        <section class="text-center space-y-6 max-w-3xl mx-auto pt-4 md:pt-8 animate-fadeIn">
          <!-- Eyebrow Pill -->
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-medium shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Cross-Platform Utility • Windows PC & Android Mobile • 100% Offline & Private</span>
          </div>

          <!-- Main Headline -->
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-display-xl text-ink font-feature-geom leading-[1.1]">
            Conquer Screenshot & Media Clutter <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">
              Across Windows & Android
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg md:text-xl text-body max-w-2xl mx-auto leading-relaxed">
            Sweepgrid is the ultimate local utility designed for Windows and Android to instantly preview, organize, and purge messy screenshot directories and temporary captures in seconds. Runs 100% locally with zero cloud bloat.
          </p>

          <!-- Dual Side-by-Side Hero Download Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <!-- 1) Download for Windows (Microsoft Store) -->
            <a 
              href="https://apps.microsoft.com/detail/9PN8GFTX73ZH" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-3 px-7 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-sm shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/35 hover:-translate-y-0.5 transition-all duration-200 no-underline cursor-pointer group"
            >
              <svg class="w-4 h-4 fill-current opacity-95 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24">
                <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm0 17.102L9.75 21.9v-9.451H0v8.102zm10.95 1.551L24 24V11.551H10.95v10.551zM24 0L10.95 1.898v9.653H24V0z"/>
              </svg>
              <span>Download for Windows (Store)</span>
            </a>

            <!-- 2) Download for Android (APK) -->
            <a 
              href="/sweepgrid.apk" 
              download="sweepgrid.apk"
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-3 px-7 py-3.5 rounded-xl bg-canvas border border-emerald-500/50 hover:border-emerald-500 hover:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold text-sm shadow-sm hover:-translate-y-0.5 transition-all duration-200 no-underline cursor-pointer group"
            >
              <svg class="w-4 h-4 fill-current opacity-95 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.1 12 8.1s-3.5902.3116-5.1368.8497L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
              </svg>
              <span>Download for Android (APK)</span>
            </a>
          </div>

          <!-- Quick Trust Badges -->
          <div class="pt-2 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-mute font-mono">
            <span class="flex items-center gap-1.5">✓ Windows 10 & 11 (Store Certified)</span>
            <span class="flex items-center gap-1.5">✓ Android 10+ (APK Direct)</span>
            <span class="flex items-center gap-1.5">✓ Windows Recycle Bin & MediaStore Safe</span>
          </div>
        </section>

        <!-- DUAL PLATFORM SWITCHER & INTERACTIVE PREVIEW -->
        <section class="max-w-5xl mx-auto space-y-4">
          <!-- Platform Switcher Tab Buttons -->
          <div class="flex items-center justify-center">
            <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline shadow-sm">
              <button 
                id="tab-btn-windows" 
                type="button"
                onclick="switchPlatform('windows')"
                class="px-5 py-2 rounded-lg text-xs font-semibold flex items-center space-x-2 transition-all cursor-pointer bg-emerald-500 text-white shadow-xs"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm0 17.102L9.75 21.9v-9.451H0v8.102zm10.95 1.551L24 24V11.551H10.95v10.551zM24 0L10.95 1.898v9.653H24V0z"/>
                </svg>
                <span>Windows Desktop Dashboard</span>
              </button>
              <button 
                id="tab-btn-android" 
                type="button"
                onclick="switchPlatform('android')"
                class="px-5 py-2 rounded-lg text-xs font-semibold flex items-center space-x-2 transition-all cursor-pointer text-body hover:text-ink hover:bg-canvas-soft"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.1 12 8.1s-3.5902.3116-5.1368.8497L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
                </svg>
                <span>Android MediaStore Auto-Trash</span>
              </button>
            </div>
          </div>

          <!-- PREVIEW 1: WINDOWS DASHBOARD -->
          <div id="preview-panel-windows" class="rounded-2xl border border-hairline/80 bg-canvas shadow-level-4 overflow-hidden transition-all duration-300">
            <!-- Title Bar -->
            <div class="h-10 bg-canvas-soft border-b border-hairline px-4 flex items-center justify-between text-xs text-mute font-mono select-none">
              <div class="flex items-center space-x-2.5">
                <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                <span class="text-ink/80 text-[11px] font-medium ml-2 font-sans flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded bg-emerald-500 text-white font-bold text-[8px] flex items-center justify-center">SG</span>
                  Sweepgrid v1.0 — C:\Users\User\Pictures\Screenshots
                </span>
              </div>
              <div class="flex items-center space-x-3 text-[11px]">
                <span class="hidden sm:inline px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-semibold">248 Captures Found</span>
                <span class="text-body font-semibold">1.42 GB</span>
              </div>
            </div>

            <!-- Toolbar -->
            <div class="p-3 sm:p-4 bg-canvas border-b border-hairline/60 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex flex-wrap items-center gap-2">
                <div class="px-3 py-1.5 rounded-lg bg-canvas-soft border border-hairline text-ink font-medium flex items-center space-x-1.5 select-none">
                  <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                  </svg>
                  <span>Folder: Pictures\Screenshots</span>
                </div>
                
                <div class="hidden sm:flex items-center space-x-1 pl-2 border-l border-hairline">
                  <span class="px-2.5 py-1 rounded-md bg-emerald-500 text-white font-medium text-[11px]">All (248)</span>
                  <span class="px-2.5 py-1 rounded-md text-body text-[11px]">Older than 30d (114)</span>
                  <span class="px-2.5 py-1 rounded-md text-body text-[11px]">Temporary Snips (86)</span>
                </div>
              </div>

              <div class="flex items-center space-x-2">
                <span class="text-[11px] text-mute hidden md:inline">Selected: 48 items (320 MB)</span>
                <div class="px-3 py-1.5 rounded-lg bg-emerald-500 text-white font-semibold text-xs shadow-xs flex items-center space-x-1.5 select-none">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  <span>Quick Clean to Recycle Bin</span>
                </div>
              </div>
            </div>

            <!-- Windows Thumbnail Grid -->
            <div class="p-4 sm:p-6 bg-canvas-soft-2 grid grid-cols-2 sm:grid-cols-4 gap-4 select-none">
              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-emerald-500 bg-emerald-500 text-white flex items-center justify-center text-[9px] font-bold">✓</div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">1920x1080</div>
                  <span class="text-2xl opacity-60">🖼️</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Screenshot_2026-11-20_0912.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>3.4 MB</span>
                    <span class="text-emerald-500 font-semibold">Selected</span>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-emerald-500 bg-emerald-500 text-white flex items-center justify-center text-[9px] font-bold">✓</div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">2560x1440</div>
                  <span class="text-2xl opacity-60">📊</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Meeting_Notes_Quarterly.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>5.8 MB</span>
                    <span class="text-emerald-500 font-semibold">Selected</span>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-hairline-strong bg-canvas flex items-center justify-center"></div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">1920x1080</div>
                  <span class="text-2xl opacity-60">📑</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Invoice_Receipt_Confirm.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>1.2 MB</span>
                    <span>Kept</span>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-emerald-500 bg-emerald-500 text-white flex items-center justify-center text-[9px] font-bold">✓</div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">1920x1080</div>
                  <span class="text-2xl opacity-60">💻</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Terminal_Debug_Capture.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>2.1 MB</span>
                    <span class="text-emerald-500 font-semibold">Selected</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- PREVIEW 2: ANDROID MEDIASTORE AUTO-TRASH SCREEN -->
          <div id="preview-panel-android" class="hidden rounded-2xl border border-hairline/80 bg-canvas shadow-level-4 overflow-hidden transition-all duration-300">
            <!-- Mobile Frame Container -->
            <div class="max-w-md mx-auto p-4 sm:p-6">
              <div class="rounded-3xl border-2 border-hairline bg-canvas-soft shadow-level-3 overflow-hidden">
                <!-- Android Status Bar -->
                <div class="h-7 bg-canvas-soft px-4 flex items-center justify-between text-[10px] text-mute font-mono border-b border-hairline/40">
                  <span class="font-bold text-ink">09:41</span>
                  <div class="flex items-center space-x-1.5">
                    <span>📶 5G</span>
                    <span>🔋 98%</span>
                  </div>
                </div>

                <!-- Android App Bar -->
                <div class="p-3 bg-canvas border-b border-hairline flex items-center justify-between">
                  <div class="flex items-center space-x-2">
                    <span class="w-6 h-6 rounded bg-emerald-500 text-white font-extrabold text-[10px] flex items-center justify-center">SG</span>
                    <div>
                      <h4 class="text-xs font-bold text-ink leading-tight">Sweepgrid Mobile</h4>
                      <p class="text-[9px] text-mute font-mono">/storage/emulated/0/DCIM/Screenshots</p>
                    </div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 text-[10px] font-semibold font-mono">MediaStore Sync</span>
                </div>

                <!-- Android Storage & Auto-Trash Rule Card -->
                <div class="p-3 space-y-2.5">
                  <div class="p-3 rounded-xl bg-canvas border border-hairline space-y-2">
                    <div class="flex items-center justify-between text-xs">
                      <span class="font-semibold text-ink">MediaStore Storage Audit</span>
                      <span class="text-emerald-500 font-bold font-mono">890 MB Recoverable</span>
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-canvas-soft overflow-hidden">
                      <div class="h-full bg-emerald-500 w-3/4 rounded-full"></div>
                    </div>
                    <div class="flex items-center justify-between text-[10px] text-mute">
                      <span>184 snips found</span>
                      <span>Target: Auto-Trash</span>
                    </div>
                  </div>

                  <!-- Auto-trash filter pills -->
                  <div class="flex items-center space-x-1.5 overflow-x-auto pb-1 text-[10px]">
                    <span class="px-2.5 py-1 rounded-md bg-emerald-500 text-white font-semibold">Screenshots (112)</span>
                    <span class="px-2.5 py-1 rounded-md bg-canvas border border-hairline text-body">WhatsApp Snips (48)</span>
                    <span class="px-2.5 py-1 rounded-md bg-canvas border border-hairline text-body">OTP Codes (24)</span>
                  </div>

                  <!-- Android Media Thumbnail Grid (Vertical Aspect Ratio) -->
                  <div class="grid grid-cols-3 gap-2 select-none">
                    <div class="p-1.5 rounded-lg bg-canvas border border-emerald-500/40 space-y-1">
                      <div class="h-24 rounded bg-slate-800/10 dark:bg-slate-800/60 relative flex items-center justify-center text-xl">
                        <span class="absolute top-1 left-1 w-3 h-3 rounded bg-emerald-500 text-white text-[8px] font-bold flex items-center justify-center">✓</span>
                        📱
                      </div>
                      <p class="text-[9px] text-ink truncate font-medium">OTP_Login_Code.jpg</p>
                      <p class="text-[8px] text-emerald-500 font-mono">1.1 MB • 24h old</p>
                    </div>

                    <div class="p-1.5 rounded-lg bg-canvas border border-emerald-500/40 space-y-1">
                      <div class="h-24 rounded bg-slate-800/10 dark:bg-slate-800/60 relative flex items-center justify-center text-xl">
                        <span class="absolute top-1 left-1 w-3 h-3 rounded bg-emerald-500 text-white text-[8px] font-bold flex items-center justify-center">✓</span>
                        🧾
                      </div>
                      <p class="text-[9px] text-ink truncate font-medium">Payment_Slip_UPI.jpg</p>
                      <p class="text-[8px] text-emerald-500 font-mono">2.4 MB • 5d old</p>
                    </div>

                    <div class="p-1.5 rounded-lg bg-canvas border border-hairline space-y-1">
                      <div class="h-24 rounded bg-slate-800/10 dark:bg-slate-800/60 relative flex items-center justify-center text-xl">
                        📷
                      </div>
                      <p class="text-[9px] text-ink truncate font-medium">Flight_Boarding.jpg</p>
                      <p class="text-[8px] text-mute font-mono">1.8 MB • Kept</p>
                    </div>
                  </div>

                  <!-- Android System Trash Safe Action -->
                  <div class="pt-1">
                    <div class="w-full py-2.5 rounded-xl bg-emerald-500 text-white font-semibold text-xs flex items-center justify-center space-x-1.5 shadow-xs">
                      <span>🗑️ Send Selected to Gallery Trash (30-Day Safe)</span>
                    </div>
                    <p class="text-[9px] text-center text-mute pt-1">Compliant with Android 10+ Scoped Storage & MediaStore APIs</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- CORE FEATURE CARDS GRID (CROSS-PLATFORM) -->
        <section class="space-y-10">
          <div class="text-center space-y-2 max-w-xl mx-auto">
            <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-500 font-semibold">Engineered For Desktop & Mobile</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink font-feature-geom">
              Unified Screenshot & Trash Management
            </h2>
            <p class="text-xs sm:text-sm text-body">
              Stop digging through thousands of forgotten screen grabs across your PC folders and phone galleries.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="p-8 rounded-2xl bg-canvas border border-hairline hover:border-emerald-500/30 transition-all duration-200 shadow-level-2 space-y-4 group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl font-bold group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">Visual Grid & MediaStore Overview</h3>
              <p class="text-body text-xs sm:text-sm leading-relaxed">
                Seamless visual folder mapping for Windows PC and native MediaStore indexing for Android. Instantly groups captures by date, size, and snippet type.
              </p>
            </div>

            <!-- Card 2 -->
            <div class="p-8 rounded-2xl bg-canvas border border-hairline hover:border-emerald-500/30 transition-all duration-200 shadow-level-2 space-y-4 group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl font-bold group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">One-Click Quick Clean & Auto-Trash</h3>
              <p class="text-body text-xs sm:text-sm leading-relaxed">
                Purge clutter with total peace of mind. Uses native Windows Recycle Bin integration on PC and Android system MediaStore trash with 30-day restore protection.
              </p>
            </div>

            <!-- Card 3 -->
            <div class="p-8 rounded-2xl bg-canvas border border-hairline hover:border-emerald-500/30 transition-all duration-200 shadow-level-2 space-y-4 group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl font-bold group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
