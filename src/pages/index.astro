---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Sweepgrid — Smart Windows Screenshot & File Organizer" 
  description="Sweepgrid is the ultimate local utility designed for Windows to instantly preview, organize, and purge messy screenshot directories in seconds."
>
  <!-- Background Mesh Gradient decoration -->
  <div class="mesh-gradient-bg"></div>

  <div class="min-h-screen flex flex-col font-sans">
    <Header currentView="home" />

    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8 md:py-12">
      
      <!-- ========================================== -->
      <!-- VIEW 1: HOME PAGE                          -->
      <!-- ========================================== -->
      <div id="page-home" class="page-view active space-y-16 md:space-y-24">
        
        <!-- HERO SECTION -->
        <section class="text-center space-y-6 max-w-3xl mx-auto pt-4 md:pt-8 animate-fadeIn">
          <!-- Eyebrow Pill -->
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-medium shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Native Windows Utility • 100% Offline & Private</span>
          </div>

          <!-- Main Headline -->
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-display-xl text-ink font-feature-geom leading-[1.1]">
            Conquer Your Desktop <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">
              Screenshot Clutter
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg md:text-xl text-body max-w-2xl mx-auto leading-relaxed">
            Sweepgrid is the ultimate local utility designed for Windows to instantly preview, organize, and purge messy screenshot directories in seconds.
          </p>

          <!-- CTA Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href="https://apps.microsoft.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-2.5 px-8 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-sm shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/35 hover:-translate-y-0.5 transition-all duration-200 no-underline cursor-pointer group"
            >
              <svg class="w-4 h-4 fill-current opacity-95 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm0 17.102L9.75 21.9v-9.451H0v8.102zm10.95 1.551L24 24V11.551H10.95v10.551zM24 0L10.95 1.898v9.653H24V0z"/>
              </svg>
              <span>Get it on Microsoft Store</span>
            </a>

            <button 
              type="button"
              onclick="switchPage('help')"
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 px-6 py-3.5 rounded-xl bg-canvas border border-hairline hover:border-hairline-strong text-body hover:text-ink font-semibold text-sm transition-all duration-200 no-underline shadow-sm hover:bg-canvas-soft cursor-pointer"
            >
              <span>Explore Help & FAQ</span>
              <svg class="w-3.5 h-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Quick Trust Badges -->
          <div class="pt-2 flex flex-wrap items-center justify-center gap-6 text-xs text-mute font-mono">
            <span class="flex items-center gap-1.5">✓ 100% Free & Local</span>
            <span class="flex items-center gap-1.5">✓ No Telemetry / Tracking</span>
            <span class="flex items-center gap-1.5">✓ Windows 10 & 11 Ready</span>
          </div>
        </section>

        <!-- APP WINDOW MOCKUP PREVIEW -->
        <section class="max-w-5xl mx-auto">
          <div class="rounded-2xl border border-hairline/80 bg-canvas shadow-level-4 overflow-hidden transition-all duration-300">
            
            <!-- Mock Window Title Bar -->
            <div class="h-10 bg-canvas-soft border-b border-hairline px-4 flex items-center justify-between text-xs text-mute font-mono select-none">
              <div class="flex items-center space-x-2.5">
                <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                <span class="text-ink/80 text-[11px] font-medium ml-2 font-sans flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded bg-emerald-500 text-white font-bold text-[8px] flex items-center justify-center">SG</span>
                  Sweepgrid — C:\Users\User\Pictures\Screenshots
                </span>
              </div>
              <div class="flex items-center space-x-3 text-[11px]">
                <span class="hidden sm:inline px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-semibold">248 Captures Found</span>
                <span class="text-body font-semibold">1.42 GB</span>
              </div>
            </div>

            <!-- Mock Window Toolbar -->
            <div class="p-3 sm:p-4 bg-canvas border-b border-hairline/60 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex flex-wrap items-center gap-2">
                <div class="px-3 py-1.5 rounded-lg bg-canvas-soft border border-hairline text-ink font-medium flex items-center space-x-1.5 select-none">
                  <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                  </svg>
                  <span>Target Folder: Screenshots</span>
                </div>
                
                <div class="hidden sm:flex items-center space-x-1 pl-2 border-l border-hairline">
                  <span class="px-2.5 py-1 rounded-md bg-emerald-500 text-white font-medium text-[11px]">All (248)</span>
                  <span class="px-2.5 py-1 rounded-md text-body text-[11px]">Older than 30d (114)</span>
                  <span class="px-2.5 py-1 rounded-md text-body text-[11px]">Temporary Snips (86)</span>
                </div>
              </div>

              <div class="flex items-center space-x-2">
                <span class="text-[11px] text-mute hidden md:inline">Selected: 48 items (320 MB)</span>
                <div class="px-3 py-1.5 rounded-lg bg-emerald-500 text-white font-semibold text-xs shadow-xs flex items-center space-x-1.5 select-none">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  <span>Quick Clean to Recycle Bin</span>
                </div>
              </div>
            </div>

            <!-- Mock Visual Grid Layout -->
            <div class="p-4 sm:p-6 bg-canvas-soft-2 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 select-none">
              
              <!-- Mock Thumbnail 1 -->
              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-emerald-500 bg-emerald-500 text-white flex items-center justify-center text-[9px] font-bold">✓</div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">1920x1080</div>
                  <span class="text-2xl opacity-60">🖼️</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Screenshot_2026-11-14_0912.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>3.4 MB</span>
                    <span class="text-emerald-500 font-semibold">Selected</span>
                  </div>
                </div>
              </div>

              <!-- Mock Thumbnail 2 -->
              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-emerald-500 bg-emerald-500 text-white flex items-center justify-center text-[9px] font-bold">✓</div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">2560x1440</div>
                  <span class="text-2xl opacity-60">📊</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Snip_Meeting_Notes_Q4.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>5.8 MB</span>
                    <span class="text-emerald-500 font-semibold">Selected</span>
                  </div>
                </div>
              </div>

              <!-- Mock Thumbnail 3 -->
              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-hairline-strong bg-canvas flex items-center justify-center"></div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">1920x1080</div>
                  <span class="text-2xl opacity-60">📑</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Invoice_Receipt_Confirm.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>1.2 MB</span>
                    <span>Kept</span>
                  </div>
                </div>
              </div>

              <!-- Mock Thumbnail 4 -->
              <div class="rounded-xl border border-hairline bg-canvas p-2.5 space-y-2 shadow-xs group hover:border-emerald-500/40 transition-colors hidden sm:block">
                <div class="h-28 rounded-lg bg-slate-800/10 dark:bg-slate-800/60 border border-hairline/50 flex flex-col items-center justify-center relative overflow-hidden">
                  <div class="absolute top-2 left-2 w-3.5 h-3.5 rounded border border-emerald-500 bg-emerald-500 text-white flex items-center justify-center text-[9px] font-bold">✓</div>
                  <div class="absolute bottom-1 right-2 text-[10px] font-mono text-mute">1920x1080</div>
                  <span class="text-2xl opacity-60">💻</span>
                </div>
                <div class="space-y-0.5">
                  <p class="text-[11px] font-medium text-ink truncate">Terminal_Error_Log.png</p>
                  <div class="flex items-center justify-between text-[10px] text-mute font-mono">
                    <span>2.1 MB</span>
                    <span class="text-emerald-500 font-semibold">Selected</span>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </section>

        <!-- CORE FEATURE CARDS GRID -->
        <section class="space-y-10">
          <div class="text-center space-y-2 max-w-xl mx-auto">
            <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-500 font-semibold">Engineered For Performance</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink font-feature-geom">
              Designed for Instant Clarity & Zero Bloat
            </h2>
            <p class="text-xs sm:text-sm text-body">
              Stop digging through thousands of unorganized files in Windows File Explorer.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="p-8 rounded-2xl bg-canvas border border-hairline hover:border-emerald-500/30 transition-all duration-200 shadow-level-2 space-y-4 group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl font-bold group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">Visual Grid Overview</h3>
              <p class="text-body text-xs sm:text-sm leading-relaxed">
                Instantly map out chaotic folders into a clean, intuitive layout designed for rapid identification and management.
              </p>
            </div>

            <!-- Card 2 -->
            <div class="p-8 rounded-2xl bg-canvas border border-hairline hover:border-emerald-500/30 transition-all duration-200 shadow-level-2 space-y-4 group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl font-bold group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">One-Click Quick Clean</h3>
              <p class="text-body text-xs sm:text-sm leading-relaxed">
                Effortlessly purge unwanted captures and reclaim valuable local disk space without wading through complex menus.
              </p>
            </div>

            <!-- Card 3 -->
            <div class="p-8 rounded-2xl bg-canvas border border-hairline hover:border-emerald-500/30 transition-all duration-200 shadow-level-2 space-y-4 group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl font-bold group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">100% Private & Local</h3>
              <p class="text-body text-xs sm:text-sm leading-relaxed">
                Runs entirely offline on your machine. Your personal captures never touch external cloud servers or tracking pipelines.
              </p>
            </div>
          </div>
        </section>

        <!-- HOW IT WORKS IN 3 STEPS -->
        <section class="max-w-4xl mx-auto space-y-8 border-t border-hairline pt-16">
          <div class="text-center space-y-2">
            <span class="font-mono text-[10px] uppercase tracking-wider text-violet font-semibold">Workflow Simplicity</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink font-feature-geom">
              How Sweepgrid Operates
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
            <div class="p-6 rounded-xl bg-canvas border border-hairline space-y-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-emerald-500 text-white font-mono font-bold flex items-center justify-center text-xs">1</span>
              <h4 class="font-bold text-ink text-sm font-feature-geom">Target Any Folder</h4>
              <p class="text-body leading-relaxed">
                Sweepgrid automatically recognizes default Windows screenshot folders or lets you pick any custom local storage drive.
              </p>
            </div>

            <div class="p-6 rounded-xl bg-canvas border border-hairline space-y-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-emerald-500 text-white font-mono font-bold flex items-center justify-center text-xs">2</span>
              <h4 class="font-bold text-ink text-sm font-feature-geom">Rapid Visual Triage</h4>
              <p class="text-body leading-relaxed">
                Scan through high-resolution thumbnails, filter by age or dimensions, and isolate outdated snips in a few keystrokes.
              </p>
            </div>

            <div class="p-6 rounded-xl bg-canvas border border-hairline space-y-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-emerald-500 text-white font-mono font-bold flex items-center justify-center text-xs">3</span>
              <h4 class="font-bold text-ink text-sm font-feature-geom">Safely Reclaim Disk Space</h4>
              <p class="text-body leading-relaxed">
                Purge files with Recycle Bin protection so you can instantly free up gigabytes of disk space with absolute peace of mind.
              </p>
            </div>
          </div>
        </section>

        <!-- BOTTOM CALL TO ACTION BANNER -->
        <section class="rounded-3xl border border-hairline bg-canvas p-8 sm:p-12 text-center space-y-6 shadow-level-3 relative overflow-hidden">
          <div class="max-w-2xl mx-auto space-y-3">
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink font-feature-geom">
              Reclaim Your Desktop Space Today
            </h2>
            <p class="text-xs sm:text-sm text-body">
              Get Sweepgrid on the Microsoft Store and say goodbye to cluttered screenshot folders forever.
            </p>
          </div>

          <div>
            <a 
              href="https://apps.microsoft.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center space-x-2.5 px-8 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-sm shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/35 hover:-translate-y-0.5 transition-all duration-200 no-underline cursor-pointer group"
            >
              <svg class="w-4 h-4 fill-current opacity-95 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm0 17.102L9.75 21.9v-9.451H0v8.102zm10.95 1.551L24 24V11.551H10.95v10.551zM24 0L10.95 1.898v9.653H24V0z"/>
              </svg>
              <span>Get it on Microsoft Store</span>
            </a>
          </div>
        </section>

      </div>

      <!-- ========================================== -->
      <!-- VIEW 2: ABOUT US PAGE                      -->
      <!-- ========================================== -->
      <div id="page-about" class="page-view space-y-12">
        <!-- Breadcrumb navigation -->
        <div class="flex items-center space-x-2 text-xs font-mono text-mute">
          <a onclick="switchPage('home')" class="hover:text-ink transition-colors no-underline text-mute cursor-pointer">Home</a>
          <span>/</span>
          <span class="text-ink font-semibold">About Us</span>
        </div>

        <!-- Header Section -->
        <header class="space-y-3 border-b border-hairline pb-8 text-center max-w-3xl mx-auto">
          <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-500 font-semibold">ABOUT SWEEPGRID</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-display-lg text-ink font-feature-geom">
            About Sweepgrid.
          </h2>
          <p class="text-sm sm:text-base text-body leading-relaxed">
            Engineered by The Black Rose for clean, lightning-fast local workspace management.
          </p>
        </header>

        <!-- Main Content Box -->
        <div class="space-y-8 max-w-4xl mx-auto text-xs sm:text-sm text-body leading-relaxed">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-8 border border-hairline bg-canvas rounded-2xl space-y-4 shadow-level-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">
                🎯
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">Our Mission</h3>
              <p>
                Modern workflows generate hundreds of accidental screenshots, temporary image snippets, and desktop clutter. Whether capturing debug snippets, receipts, meeting slides, or design references, folders quickly balloon into gigabytes of disarray.
              </p>
              <p>
                <strong>Sweepgrid</strong> was built out of a desire for a native, lightning-fast utility that puts users back in complete control of their storage without heavy background bloatware or complicated configurations.
              </p>
            </div>

            <div class="p-8 border border-hairline bg-canvas rounded-2xl space-y-4 shadow-level-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">
                🪟
              </div>
              <h3 class="text-lg font-bold text-ink font-feature-geom">Built for Windows</h3>
              <p>
                Optimized specifically for Windows architecture using high-performance modern UI frameworks, Sweepgrid delivers a seamless experience that respects your system resources and file privacy.
              </p>
              <p>
                Unlike bloated web-wrapped software, Sweepgrid starts instantly, reads your local file system with native speed, and works cleanly with Windows 10 and Windows 11 conventions.
              </p>
            </div>
          </div>

          <!-- The Black Rose Philosophy -->
          <div class="p-8 border border-hairline bg-canvas rounded-2xl space-y-4 shadow-level-2">
            <div class="flex items-center space-x-3">
              <span class="w-7 h-7 rounded-md bg-emerald-500 text-white font-bold text-xs flex items-center justify-center">SG</span>
              <h3 class="text-lg font-bold text-ink font-feature-geom">Engineered by The Black Rose</h3>
            </div>
            <p>
              The Black Rose designs focused, purpose-built utilities that solve common everyday computing frustrations with surgical precision. We believe software should:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <li class="p-4 rounded-xl bg-canvas-soft border border-hairline space-y-1">
                <strong class="text-ink font-semibold block text-xs">🔒 100% Private</strong>
                <span class="text-[11px] text-mute">Never upload your files, track telemetry, or require cloud sync.</span>
              </li>
              <li class="p-4 rounded-xl bg-canvas-soft border border-hairline space-y-1">
                <strong class="text-ink font-semibold block text-xs">⚡ Instant & Nimble</strong>
                <span class="text-[11px] text-mute">Zero lag, tiny memory footprint, and no background daemons.</span>
              </li>
              <li class="p-4 rounded-xl bg-canvas-soft border border-hairline space-y-1">
                <strong class="text-ink font-semibold block text-xs">🛡️ Safe Deletions</strong>
                <span class="text-[11px] text-mute">Recycle Bin protection so you never lose critical documents.</span>
              </li>
            </ul>
          </div>

        </div>
      </div>

      <!-- ========================================== -->
      <!-- VIEW 3: HELP CENTER PAGE                   -->
      <!-- ========================================== -->
      <div id="page-help" class="page-view space-y-12">
        <!-- Breadcrumb navigation -->
        <div class="flex items-center space-x-2 text-xs font-mono text-mute">
          <a onclick="switchPage('home')" class="hover:text-ink transition-colors no-underline text-mute cursor-pointer">Home</a>
