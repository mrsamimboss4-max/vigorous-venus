<!-- SPA Page-View Switcher & Platform Dual-Preview Script -->
<script is:inline>
  (function() {
    const validPages = ['home', 'about', 'help', 'contact'];

    // Platform switcher for interactive mockup (Windows vs Android)
    window.switchPlatform = function(platform) {
      const btnWin = document.getElementById('tab-btn-windows');
      const btnAnd = document.getElementById('tab-btn-android');
      const panelWin = document.getElementById('preview-panel-windows');
      const panelAnd = document.getElementById('preview-panel-android');

      if (!btnWin || !btnAnd || !panelWin || !panelAnd) return;

      if (platform === 'android') {
        panelWin.classList.add('hidden');
        panelAnd.classList.remove('hidden');

        btnAnd.classList.add('bg-emerald-500', 'text-white', 'shadow-xs');
        btnAnd.classList.remove('text-body');
        btnWin.classList.remove('bg-emerald-500', 'text-white', 'shadow-xs');
        btnWin.classList.add('text-body');
      } else {
        panelAnd.classList.add('hidden');
        panelWin.classList.remove('hidden');

        btnWin.classList.add('bg-emerald-500', 'text-white', 'shadow-xs');
        btnWin.classList.remove('text-body');
        btnAnd.classList.remove('bg-emerald-500', 'text-white', 'shadow-xs');
        btnAnd.classList.add('text-body');
      }
    };

    // SPA Page view switcher
    window.switchPage = function(pageId) {
      if (!validPages.includes(pageId)) {
        pageId = 'home';
      }

      // Hide all page views
      document.querySelectorAll('.page-view').forEach(el => {
        el.classList.remove('active');
        el.style.display = 'none';
      });

      // Show targeted view
      const targetView = document.getElementById('page-' + pageId);
      if (targetView) {
        targetView.style.display = 'block';
        targetView.classList.add('active');
      }

      // Update Nav Link Active States
      document.querySelectorAll('.nav-tab-trigger').forEach(link => {
        const target = link.getAttribute('data-target');
        if (target === pageId) {
          link.classList.add('text-emerald-500', 'font-semibold', 'bg-emerald-500/10');
          link.classList.remove('text-body');
        } else {
          link.classList.remove('text-emerald-500', 'font-semibold', 'bg-emerald-500/10');
          link.classList.add('text-body');
        }
      });

      // Update URL hash without causing full reload
      if (window.location.hash !== '#' + pageId) {
        history.pushState(null, '', '#' + pageId);
      }

      // Scroll to top
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Initialize View from URL Hash
    const initPageFromHash = () => {
      const hash = window.location.hash.replace('#', '').toLowerCase();
      if (validPages.includes(hash)) {
        window.switchPage(hash);
      } else {
        window.switchPage('home');
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      initPageFromHash();

      // Intercept clicks on any element with data-target
      document.querySelectorAll('.nav-tab-trigger').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = btn.getAttribute('data-target');
          if (target && validPages.includes(target)) {
            e.preventDefault();
            window.switchPage(target);
          }
        });
      });

      // Contact Form Web3Forms API submission
      const form = document.getElementById('spa-contact-form');
      const status = document.getElementById('spa-contact-status');
      const statusTitle = document.getElementById('spa-contact-status-title');
      const statusMsg = document.getElementById('spa-contact-status-msg');
      const submitBtn = document.getElementById('spa-contact-submit');
      const btnContent = document.getElementById('spa-contact-btn-content');
      const btnSpinner = document.getElementById('spa-contact-btn-spinner');

      const WEB3FORMS_ACCESS_KEY = "YOUR_ACCESS_KEY_HERE";

      if (form && status && submitBtn && btnContent && btnSpinner) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          // 1. Show loading spinner on the button
          submitBtn.disabled = true;
          btnContent.classList.add('hidden');
          btnContent.classList.remove('inline-flex');
          btnSpinner.classList.remove('hidden');
          btnSpinner.classList.add('inline-flex');

          // Hide previous status message
          status.classList.add('hidden');
          status.classList.remove('bg-emerald-500/10', 'border-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400', 'bg-rose-500/10', 'border-rose-500/20', 'text-rose-600', 'dark:text-rose-400', 'border');

          // Gather form fields
          const nameVal = document.getElementById('form-name')?.value || '';
          const emailVal = document.getElementById('form-email')?.value || '';
          const categoryVal = document.getElementById('form-category')?.value || 'Windows';
          const messageVal = document.getElementById('form-message')?.value || '';

          const payload = {
            access_key: WEB3FORMS_ACCESS_KEY,
            subject: "New Sweepgrid Support Message",
            from_name: "Sweepgrid Website",
            name: nameVal,
            email: emailVal,
            platform: categoryVal,
            message: messageVal
          };

          try {
            const response = await fetch("https://api.web3forms.com/submit", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              },
              body: JSON.stringify(payload)
            });

            const data = await response.json().catch(() => ({}));

            if (response.ok && data.success) {
              form.reset();
              status.className = "p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs animate-fadeIn space-y-1";
              if (statusTitle) statusTitle.textContent = "✓ Message sent!";
              if (statusMsg) statusMsg.textContent = "Message sent! We'll reply within 24 hours.";
              status.classList.remove('hidden');

              // Dispatch global toast
              window.dispatchEvent(new CustomEvent('show-toast', {
                detail: { message: "Message sent! We'll reply within 24 hours.", type: 'success' }
              }));
            } else {
              throw new Error(data.message || "Failed to submit message to Web3Forms.");
            }
          } catch (err) {
            console.error("Web3Forms error:", err);
            status.className = "p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs animate-fadeIn space-y-1";
            if (statusTitle) statusTitle.textContent = "⚠️ Unable to Send Message";
            if (statusMsg) statusMsg.textContent = err.message || "A network error occurred. Please check your connection and try again.";
            status.classList.remove('hidden');

            window.dispatchEvent(new CustomEvent('show-toast', {
              detail: { message: err.message || "Failed to send message. Please try again.", type: 'error' }
            }));
          } finally {
            submitBtn.disabled = false;
            btnSpinner.classList.add('hidden');
            btnSpinner.classList.remove('inline-flex');
            btnContent.classList.remove('hidden');
            btnContent.classList.add('inline-flex');
          }
        });
      }
    });

    // Handle Browser Back / Forward History Navigation
    window.addEventListener('popstate', () => {
      initPageFromHash();
    });
  })();
</script>

<style>
  .page-view {
    display: none;
    animation: fadeIn 0.3s ease-in-out forwards;
  }

  .page-view.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
