<!-- SPA Page-View Switcher Script -->
<script is:inline>
  (function() {
    const validPages = ['home', 'about', 'help', 'contact'];

    window.switchPage = function(pageId) {
      if (!validPages.includes(pageId)) {
        pageId = 'home';
      }

      // Hide all page views
      document.querySelectorAll('.page-view').forEach(el => {
        el.classList.remove('active');
        el.style.display = 'none';
      });

      // Show targeted view
      const targetView = document.getElementById('page-' + pageId);
      if (targetView) {
        targetView.style.display = 'block';
        targetView.classList.add('active');
      }

      // Update Nav Link Active States
      document.querySelectorAll('.nav-tab-trigger').forEach(link => {
        const target = link.getAttribute('data-target');
        if (target === pageId) {
          link.classList.add('text-emerald-500', 'font-semibold', 'bg-emerald-500/10');
          link.classList.remove('text-body');
        } else {
          link.classList.remove('text-emerald-500', 'font-semibold', 'bg-emerald-500/10');
          link.classList.add('text-body');
        }
      });

      // Update URL hash without causing full reload
      if (window.location.hash !== '#' + pageId) {
        history.pushState(null, '', '#' + pageId);
      }

      // Scroll to top
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Initialize View from URL Hash
    const initPageFromHash = () => {
      const hash = window.location.hash.replace('#', '').toLowerCase();
      if (validPages.includes(hash)) {
        window.switchPage(hash);
      } else {
        window.switchPage('home');
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      initPageFromHash();

      // Intercept clicks on any element with data-target
      document.querySelectorAll('.nav-tab-trigger').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = btn.getAttribute('data-target');
          if (target && validPages.includes(target)) {
            e.preventDefault();
            window.switchPage(target);
          }
        });
      });

      // Contact Form simulation handling
      const form = document.getElementById('spa-contact-form');
      const status = document.getElementById('spa-contact-status');
      const submitBtn = document.getElementById('spa-contact-submit');

      if (form && status && submitBtn) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-75');

          setTimeout(() => {
            form.reset();
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-75');
            status.classList.remove('hidden');

            // Dispatch global toast
            window.dispatchEvent(new CustomEvent('show-toast', {
              detail: { message: 'Message simulated successfully! We will get back to you soon.', type: 'success' }
            }));
          }, 400);
        });
      }
    });

    // Handle Browser Back / Forward History Navigation
    window.addEventListener('popstate', () => {
      initPageFromHash();
    });
  })();
</script>

<style>
  .page-view {
