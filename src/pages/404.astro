---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="404: Page Not Found — Sweepgrid" 
  description="This page does not exist. Head back to Sweepgrid to organize your desktop captures."
>
  <div class="mesh-gradient-bg"></div>
  <div class="min-h-screen flex flex-col font-sans">
    <Header />
    
    <main class="flex-1 flex flex-col items-center justify-center text-center px-4 sm:px-6 py-20 max-w-xl mx-auto space-y-6">
      <span class="font-mono text-xs uppercase tracking-widest text-emerald-500 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20 font-semibold">
        Error 404
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-display-lg text-ink font-feature-geom">
        Page Not Found.
      </h1>
      <p class="text-xs sm:text-sm text-body leading-relaxed max-w-md mx-auto">
        The page you are looking for does not exist, has been moved, or is temporarily offline. Return to Sweepgrid's homepage to learn more.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2 w-full sm:w-auto">
        <a 
          href="/" 
          class="w-full sm:w-auto px-6 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs font-semibold shadow-sm hover:shadow-emerald-500/20 transition-all flex items-center justify-center no-underline"
        >
          Return to Home
        </a>
        <a 
          href="/contact" 
          class="w-full sm:w-auto px-6 py-2.5 border border-hairline hover:border-hairline-strong rounded-xl text-xs font-medium text-body hover:text-ink bg-canvas transition-colors flex items-center justify-center no-underline"
        >
          Contact Support
        </a>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
