---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contact Us — Sweepgrid (Windows & Android)" 
  description="Have questions, feedback, or feature requests for Sweepgrid on Windows or Android? Get in touch with The Black Rose team."
>
  <div class="mesh-gradient-bg"></div>
  <div class="min-h-screen flex flex-col font-sans">
    <Header currentView="contact" />
    
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-12 md:py-16 space-y-12 animate-fadeIn">
      <!-- Breadcrumb navigation -->
      <div class="flex items-center space-x-2 text-xs font-mono text-mute">
        <a href="/#home" class="hover:text-ink transition-colors no-underline text-mute">Home</a>
        <span>/</span>
        <span class="text-ink font-semibold">Contact</span>
      </div>

      <!-- Header Section -->
      <header class="space-y-3 border-b border-hairline pb-8 text-center max-w-2xl mx-auto">
        <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-500 font-semibold">DIRECT DEVELOPER DESK</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-display-lg text-ink font-feature-geom">
          Get in Touch.
        </h1>
        <p class="text-sm sm:text-base text-body leading-relaxed">
          Need support with Windows or Android? Have feature requests or suggestions? Reach out directly.
        </p>
      </header>

      <!-- Main Contact Container -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Form Container -->
        <div class="md:col-span-8 p-6 sm:p-8 rounded-2xl bg-canvas border border-hairline shadow-level-2 space-y-6">
          <form id="sweepgrid-contact-form" class="space-y-5">
            <!-- Name Input -->
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-semibold text-ink">
                Your Name <span class="text-emerald-500">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                placeholder="John Doe" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-canvas-soft border border-hairline text-ink text-xs sm:text-sm placeholder:text-mute focus:outline-none focus:border-emerald-500 transition-colors"
              />
            </div>

            <!-- Email Input -->
            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-semibold text-ink">
                Your Email Address <span class="text-emerald-500">*</span>
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                placeholder="john@example.com" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-canvas-soft border border-hairline text-ink text-xs sm:text-sm placeholder:text-mute focus:outline-none focus:border-emerald-500 transition-colors"
              />
            </div>

            <!-- Platform Selector -->
            <div class="space-y-1.5">
              <label for="contact-platform" class="block text-xs font-semibold text-ink">
                Operating System / Platform
              </label>
              <select 
                id="contact-platform" 
                name="platform"
                class="w-full px-4 py-3 rounded-xl bg-canvas-soft border border-hairline text-ink text-xs sm:text-sm focus:outline-none focus:border-emerald-500 transition-colors cursor-pointer"
              >
                <option value="windows">Windows PC (Microsoft Store)</option>
                <option value="android">Android Mobile (APK / Scoped Storage)</option>
                <option value="both">Both Windows & Android</option>
                <option value="general">General Inquiry / Partnership</option>
              </select>
            </div>

            <!-- Message Textarea -->
            <div class="space-y-1.5">
              <label for="contact-message" class="block text-xs font-semibold text-ink">
                Message <span class="text-emerald-500">*</span>
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="5" 
                placeholder="Describe your bug report, question, or feature request..." 
                required 
                class="w-full px-4 py-3 rounded-xl bg-canvas-soft border border-hairline text-ink text-xs sm:text-sm placeholder:text-mute focus:outline-none focus:border-emerald-500 transition-colors resize-y min-h-[120px]"
              ></textarea>
            </div>

            <!-- Submit Button & Fallback Mail Link -->
            <div class="space-y-3 pt-1">
              <button 
                type="submit" 
                id="contact-submit-btn" 
                class="w-full sm:w-auto inline-flex items-center justify-center space-x-2.5 px-8 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-emerald-500/25 hover:shadow-emerald-500/35 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
              >
                <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                <span>Send Message (Open in Gmail)</span>
              </button>

              <!-- Fallback mailto link for native / mobile email apps -->
              <div class="flex flex-wrap items-center gap-1.5 text-xs text-mute pt-1">
                <span>Prefer your default mail app or mobile client?</span>
                <a 
                  id="contact-mailto-fallback" 
                  href="mailto:mrsamimboss4@gmail.com?subject=%5BSweepgrid%20Support%5D%20General%20Inquiry"
                  class="text-emerald-500 font-semibold hover:underline flex items-center gap-1"
                >
                  <span>Open via Mail App (mailto) &rarr;</span>
                </a>
              </div>
            </div>
          </form>

          <!-- Status Toast / Confirmation Banner -->
          <div id="contact-status" class="hidden p-4 rounded-xl text-xs animate-fadeIn space-y-1">
            <p id="contact-status-title" class="font-bold"></p>
            <p id="contact-status-msg" class="text-[11px] opacity-90"></p>
          </div>
        </div>

        <!-- Support Info Sidebar -->
        <div class="md:col-span-4 space-y-6">
          <div class="p-6 rounded-2xl bg-canvas border border-hairline shadow-level-1 space-y-4 text-xs">
            <h3 class="font-bold text-sm text-ink font-feature-geom">Direct Developer Desk</h3>
            <p class="text-body leading-relaxed">
              Sweepgrid is engineered and maintained by <strong>The Black Rose</strong> for Windows PC and Android devices.
            </p>
            <div class="space-y-2 pt-2 border-t border-hairline text-mute">
              <div class="flex items-center space-x-2">
                <span>⏱️</span>
                <span>Response time: Within 24 hours</span>
              </div>
              <div class="flex items-center space-x-2">
                <span>🛡️</span>
                <span>100% Privacy: Zero data sharing</span>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-canvas border border-hairline shadow-level-1 space-y-3 text-xs">
            <h4 class="font-bold text-ink">Official Download Portals</h4>
            <ul class="space-y-2.5">
              <li>
                <a 
                  href="https://apps.microsoft.com/detail/9PN8GFTX73ZH" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-emerald-500 font-semibold hover:underline flex items-center gap-1.5"
                >
                  <span>🪟 Windows Store Link &rarr;</span>
                </a>
              </li>
              <li>
                <a 
                  href="/sweepgrid.apk" 
                  download="sweepgrid.apk" 
                  class="text-emerald-500 font-semibold hover:underline flex items-center gap-1.5"
                >
                  <span>🤖 Android APK Download &rarr;</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </main>

    <Footer />
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('sweepgrid-contact-form');
    const status = document.getElementById('contact-status');
    const statusTitle = document.getElementById('contact-status-title');
    const statusMsg = document.getElementById('contact-status-msg');
    const fallbackLink = document.getElementById('contact-mailto-fallback');

    const RECIPIENT = "mrsamimboss4@gmail.com";

    function buildUrls() {
      const name = (form.querySelector('[name="name"]')?.value || '').trim() || 'User';
      const email = (form.querySelector('[name="email"]')?.value || '').trim() || 'No email provided';
      const platformSelect = form.querySelector('[name="platform"]');
      const platformText = platformSelect?.options[platformSelect.selectedIndex]?.text || platformSelect?.value || 'General Support';
      const message = (form.querySelector('[name="message"]')?.value || '').trim() || 'No message provided';

      const subject = `[Sweepgrid Support] ${platformText}`;
      const body = `Hi Sweepgrid Support,

I am reaching out regarding Sweepgrid. Here are my details:

Name: ${name}
Reply-To Email: ${email}
Platform / Category: ${platformText}

Message:
${message}

---
Sent via Sweepgrid Support Portal`;

      const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(RECIPIENT)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const mailtoUrl = `mailto:${encodeURIComponent(RECIPIENT)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      return { gmailUrl, mailtoUrl, subject };
    }

    // Keep fallback mailto link dynamically updated as user fills in the form
    if (form && fallbackLink) {
      form.addEventListener('input', () => {
        const { mailtoUrl } = buildUrls();
        fallbackLink.href = mailtoUrl;
      });
    }

    if (form && status) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const { gmailUrl, mailtoUrl } = buildUrls();

        if (fallbackLink) {
          fallbackLink.href = mailtoUrl;
        }

        // 1. Open pre-filled Gmail compose in a new tab
        window.open(gmailUrl, '_blank', 'noopener,noreferrer');

        // 2. Display friendly confirmation & fallback assistance banner
        status.className = "p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs animate-fadeIn space-y-1.5";
        if (statusTitle) {
          statusTitle.textContent = "✓ Opening Gmail Compose...";
        }
        if (statusMsg) {
          statusMsg.innerHTML = 'A new tab has opened with your message pre-filled in Gmail. If the tab was blocked by your browser or you prefer using your device\'s default mail client, <a href="' + mailtoUrl + '" class="underline font-semibold hover:text-emerald-500">click here to open mailto</a>, or write to us directly at <strong>' + RECIPIENT + '</strong>.';
        }
        status.classList.remove('hidden');

        // 3. Dispatch global toast
        window.dispatchEvent(new CustomEvent('show-toast', {
          detail: { message: "Opening Gmail compose in new tab...", type: 'success' }
        }));
      });
    }
  });
</script>
