---
// src/components/Header.astro
interface Props {
  currentView?: string;
}

const { currentView = 'home' } = Astro.props;
---

<header class="h-16 bg-canvas/90 backdrop-blur-md border-b border-hairline sticky top-0 z-50 transition-colors duration-200">
  <div class="max-w-6xl mx-auto h-full px-4 sm:px-6 flex items-center justify-between">
    
    <!-- Brand / Logo -->
    <div class="flex items-center space-x-6">
      <a 
        href="/#home" 
        class="nav-tab-trigger flex items-center space-x-2.5 group no-underline cursor-pointer"
        data-target="home"
      >
        <span class="w-7 h-7 rounded-md bg-emerald-500 text-white font-extrabold text-xs flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform duration-200">
          SG
        </span>
        <span class="font-extrabold text-base tracking-tight text-ink font-feature-geom">
          Sweepgrid
        </span>
        <span class="hidden sm:inline-flex font-mono text-[10px] text-mute px-1.5 py-0.5 bg-canvas-soft rounded border border-hairline font-semibold">
          Windows
        </span>
      </a>

      <!-- Desktop SPA Navigation Tabs -->
      <nav class="hidden md:flex items-center space-x-1 pl-4 border-l border-hairline" id="desktop-nav">
        <a
          href="/#home"
          id="nav-link-home"
          data-target="home"
          class={`nav-tab-trigger px-3 py-1.5 rounded-md text-xs font-medium transition-colors no-underline cursor-pointer ${
            currentView === 'home'
              ? 'text-emerald-500 font-semibold bg-emerald-500/10'
              : 'text-body hover:text-ink hover:bg-canvas-soft'
          }`}
        >
          Home
        </a>
        <a
          href="/#about"
          id="nav-link-about"
          data-target="about"
          class={`nav-tab-trigger px-3 py-1.5 rounded-md text-xs font-medium transition-colors no-underline cursor-pointer ${
            currentView === 'about'
              ? 'text-emerald-500 font-semibold bg-emerald-500/10'
              : 'text-body hover:text-ink hover:bg-canvas-soft'
          }`}
        >
          About Us
        </a>
        <a
          href="/#help"
          id="nav-link-help"
          data-target="help"
          class={`nav-tab-trigger px-3 py-1.5 rounded-md text-xs font-medium transition-colors no-underline cursor-pointer ${
            currentView === 'help'
              ? 'text-emerald-500 font-semibold bg-emerald-500/10'
              : 'text-body hover:text-ink hover:bg-canvas-soft'
          }`}
        >
          Help Center
        </a>
        <a
          href="/#contact"
          id="nav-link-contact"
          data-target="contact"
          class={`nav-tab-trigger px-3 py-1.5 rounded-md text-xs font-medium transition-colors no-underline cursor-pointer ${
            currentView === 'contact'
              ? 'text-emerald-500 font-semibold bg-emerald-500/10'
              : 'text-body hover:text-ink hover:bg-canvas-soft'
          }`}
        >
          Contact
        </a>
      </nav>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center space-x-3">
      <!-- Dark / Light Theme Toggle -->
      <button 
        id="theme-toggle-btn"
        type="button"
        class="h-8 w-8 flex items-center justify-center text-body hover:text-ink hover:bg-canvas-soft rounded-md transition-colors border border-hairline cursor-pointer"
        title="Toggle Dark / Light Mode"
        aria-label="Toggle Dark Mode"
      >
        <svg id="theme-toggle-dark-icon" class="w-4 h-4 text-mute hover:text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg id="theme-toggle-light-icon" class="w-4 h-4 text-amber-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Store Download Button -->
      <a 
        href="https://apps.microsoft.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-medium text-xs shadow-sm hover:shadow-emerald-500/20 transition-all duration-200 no-underline cursor-pointer group"
      >
        <svg class="w-3.5 h-3.5 fill-current opacity-90 group-hover:scale-105 transition-transform" viewBox="0 0 24 24">
          <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm0 17.102L9.75 21.9v-9.451H0v8.102zm10.95 1.551L24 24V11.551H10.95v10.551zM24 0L10.95 1.898v9.653H24V0z"/>
        </svg>
        <span>Get on Microsoft Store</span>
      </a>

      <!-- Mobile Hamburger Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden h-8 w-8 flex items-center justify-center text-body hover:text-ink hover:bg-canvas-soft rounded-md transition-colors border border-hairline cursor-pointer"
        aria-label="Toggle Mobile Navigation"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden bg-canvas border-b border-hairline px-4 py-3 space-y-1 animate-fadeIn">
    <a
      href="/#home"
      id="mobile-link-home"
      data-target="home"
      class="nav-tab-trigger block px-3 py-2 rounded-md text-xs font-medium no-underline text-body hover:text-ink hover:bg-canvas-soft"
    >
      Home
    </a>
    <a
      href="/#about"
      id="mobile-link-about"
      data-target="about"
      class="nav-tab-trigger block px-3 py-2 rounded-md text-xs font-medium no-underline text-body hover:text-ink hover:bg-canvas-soft"
    >
      About Us
    </a>
    <a
      href="/#help"
      id="mobile-link-help"
      data-target="help"
      class="nav-tab-trigger block px-3 py-2 rounded-md text-xs font-medium no-underline text-body hover:text-ink hover:bg-canvas-soft"
    >
      Help Center
    </a>
    <a
      href="/#contact"
      id="mobile-link-contact"
      data-target="contact"
      class="nav-tab-trigger block px-3 py-2 rounded-md text-xs font-medium no-underline text-body hover:text-ink hover:bg-canvas-soft"
    >
      Contact
    </a>
    <div class="pt-2">
      <a 
        href="https://apps.microsoft.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full flex items-center justify-center space-x-2 px-3 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-medium text-xs no-underline shadow-sm"
      >
        <svg class="w-3.5 h-3.5 fill-current opacity-90" viewBox="0 0 24 24">
          <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm0 17.102L9.75 21.9v-9.451H0v8.102zm10.95 1.551L24 24V11.551H10.95v10.551zM24 0L10.95 1.898v9.653H24V0z"/>
        </svg>
        <span>Get on Microsoft Store</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile menu toggle
    const mobileBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Theme toggle handling
    const themeBtn = document.getElementById('theme-toggle-btn');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');

    const updateIcons = (isDark) => {
      if (darkIcon && lightIcon) {
        if (isDark) {
          darkIcon.classList.add('hidden');
          lightIcon.classList.remove('hidden');
        } else {
          darkIcon.classList.remove('hidden');
          lightIcon.classList.add('hidden');
        }
      }
    };

    const isCurrentDark = document.documentElement.classList.contains('dark');
    updateIcons(isCurrentDark);

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('sweepgrid-theme', isDark ? 'dark' : 'light');
        updateIcons(isDark);
      });
    }
  });
</script>
